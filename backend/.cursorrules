from fastapi import FastAPI, Query
from src.api.models import BlockfaceResponse

@app.get("/api/v1/new-endpoint", response_model=BlockfaceResponse)
async def new_endpoint(
    param: str = Query(..., description="Parameter description")
):
    """
    Endpoint description.
    
    See docs/reference/guides/[RELEVANT_GUIDE].md for details.
    """
    # Implementation
    pass
```

### Using Regulation Normalizer

```python
from src.core.regulation_normalizer import (
    normalize_regulation,
    format_day_display,
    format_time_display,
    format_duration_display
)

# Normalize a regulation from SFMTA data
normalized = normalize_regulation(
    raw_record,
    dataset_type='parking_regulations'  # or 'street_cleaning', 'meter_schedules'
)

# Format for display
day_text = format_day_display(normalized['canonical']['days'])
time_text = format_time_display(normalized['canonical']['start_time'])
```

### Running Data Analysis

```bash
# Analyze meter coverage
python scripts/analysis/analyze_on_street_meter_coverage.py

# Inspect specific CNN
python scripts/utilities/get_cnn_783420_fields.py

# Validate data quality
python scripts/utilities/validate_all_dataset_relationships.py
```

