# =============================================================================
# Curby Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's already in .gitignore)

# -----------------------------------------------------------------------------
# MongoDB Atlas
# -----------------------------------------------------------------------------
# Get from: MongoDB Atlas → Clusters → Connect → Connect your application
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
# 
# Setup steps:
# 1. Create account at https://www.mongodb.com/cloud/atlas
# 2. Create M0 (free) cluster
# 3. Database Access → Add user with read/write permissions
# 4. Network Access → Add IP (0.0.0.0/0 for development, specific IPs for production)
# 5. Copy connection string from "Connect your application"
MONGODB_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/parking_db?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# CORS Origins
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for frontend
# Development: Include all local ports Vite might use (5173-5175)
# Production: Add your production domain
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# -----------------------------------------------------------------------------
# SFMTA Data API (San Francisco Municipal Transportation Agency)
# -----------------------------------------------------------------------------
# Required for data ingestion from SFMTA open data portal
# 
# Get tokens from: https://data.sfgov.org/profile/edit/developer_settings
# Setup steps:
# 1. Create free account at https://data.sfgov.org
# 2. Go to Profile → Developer Settings
# 3. Click "Create New App Token"
# 4. Copy both tokens below (they're the same value)
SFMTA_APP_TOKEN=your_sfmta_token_here
SOCRATA_APP_TOKEN=your_socrata_token_here

# -----------------------------------------------------------------------------
# Optional: Future Features (Not Currently Used)
# -----------------------------------------------------------------------------
# These are not required for current functionality
# GEMINI_API_KEY=your_key_here
